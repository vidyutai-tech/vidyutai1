# AI Service Dockerfile for VidyutAI Dashboard (Python)
# Optimized for memory-constrained environments (t3.small)

FROM python:3.9-slim

WORKDIR /app

# Install system dependencies (minimal, cleaned up after)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy requirements
COPY ai-service/requirements.txt ./

# Install Python dependencies (optimized for memory)
RUN pip install --no-cache-dir --no-warn-script-location -r requirements.txt

# Copy source code
COPY ai-service/ ./

# Expose port
EXPOSE 8000

# Set environment variables for memory optimization
ENV PYTHONUNBUFFERED=1
ENV MALLOC_ARENA_MAX=2
ENV PYTHONDONTWRITEBYTECODE=1

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
  CMD python -c "import requests; requests.get('http://localhost:8000/health')" || exit 1

# Start the FastAPI server (with worker limits for memory)
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--limit-concurrency", "10"]

